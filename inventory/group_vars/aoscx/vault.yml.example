---
# Copy this file to vault.yml, then encrypt it:
#
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
#
# vault.yml is never versioned (see .gitignore).

# Account used on most of the fleet.
vault_oscx_user: admin
vault_oscx_password: CHANGE_ME

# Account for the oldest batch, which was never aligned with the rest.
vault_legacy_user: admin
vault_legacy_password: CHANGE_ME_TOO
